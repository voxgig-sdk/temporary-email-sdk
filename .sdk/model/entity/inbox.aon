# Entity: inbox

main: kit: entity: inbox: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "address"
      req: false
      short: "The temporary email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "messages"
      req: false
      short: "List of messages in the inbox"
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "inbox"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "address"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/inbox/{address}"
          rename: {
            param: {
              address: "id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "inbox"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

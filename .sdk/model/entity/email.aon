# Entity: email

main: kit: entity: email: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "address"
      req: true
      short: "The generated temporary email address"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "created_at"
      req: false
      short: "Timestamp when the email address was created"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "expires_at"
      req: false
      short: "Timestamp when the email address will expire"
      type: "`$STRING`"
    }
  ]

  name: "email"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/generate"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "generate"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

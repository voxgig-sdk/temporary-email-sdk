# Entity: email

main: kit: entity: email: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "address"
      req: true
      short: "The generated temporary email address"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "created_at"
      req: false
      short: "Timestamp when the email address was created"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "expires_at"
      req: false
      short: "Timestamp when the email address will expire"
      type: "`$STRING`"
    }
  ]

  name: "email"
  op: {
    load: {
      name: "load"
      points: [
        {
          contract: {
            id: "GET /api/generate"
            json: "{\"operationId\":\"generateEmail\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"success\":{\"value\":{\"address\":\"temp123@temporarymail.com\",\"created_at\":\"2024-01-01T12:00:00Z\",\"expires_at\":\"2024-01-01T13:00:00Z\"}}},\"schema\":{\"properties\":{\"address\":{\"description\":\"The generated temporary email address\",\"format\":\"email\",\"type\":\"string\"},\"created_at\":{\"description\":\"Timestamp when the email address was created\",\"format\":\"date-time\",\"type\":\"string\"},\"expires_at\":{\"description\":\"Timestamp when the email address will expire\",\"format\":\"date-time\",\"type\":\"string\"}},\"required\":[\"address\"],\"type\":\"object\"}}},\"description\":\"Successfully generated temporary email address\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code for categorizing the error\",\"type\":\"string\"},\"error\":{\"description\":\"Error message describing what went wrong\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/api/generate"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "generate"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

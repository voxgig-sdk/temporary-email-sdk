# Entity: inbox

main: kit: entity: inbox: {

  alias: field: {}

  fields: {
    address: {
      fo: "email"
      h: "Address"
      n: "address"
      r: false
      sh: "The temporary email address"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    messages: {
      h: "Messages"
      n: "messages"
      r: false
      sh: "List of messages in the inbox"
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "inbox"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/inbox/{address}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "address"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/inbox/{address}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              address: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "inbox"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

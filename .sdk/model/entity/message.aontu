# Entity: message

main: kit: entity: message: {

  alias: field: {}

  fields: [
    {
      name: "attachments"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "body"
      req: false
      type: "`$STRING`"
    }
    {
      name: "from"
      req: false
      type: "`$STRING`"
    }
    {
      name: "html_body"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "received_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "subject"
      req: false
      type: "`$STRING`"
    }
    {
      name: "to"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "message"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "message_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/message/{messageId}"
          parts: [
            "api"
            "message"
            "{id}"
          ]
          rename: {
            param: {
              messageId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
